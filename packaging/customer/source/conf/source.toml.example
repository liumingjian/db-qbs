# Copy to /opt/tools/db-qbs/conf/source.toml and edit before starting.
# This file contains service settings only. Database credentials live in the
# source data directory after they are saved from the web UI.

# Web UI and source orchestration service. Restrict this port to trusted admin
# hosts with the host firewall or an existing reverse proxy.
listen = "0.0.0.0:18088"

# Oracle Instant Client directory installed by this package.
oracle_client_lib_dir = "/opt/tools/db-qbs/oracle/instantclient"

# Runtime data and run history. Keep this directory persistent.
data_dir = "/opt/tools/db-qbs/data/source"

# Child process used by db-qbs-source to execute one migration run.
run_executable = "/opt/tools/db-qbs/bin/db-qbs-source-run"

# Keep 90 days of run history by default.
history_retention_days = 90
