# Store the real sink.toml outside version control and chmod it 0600.
# mysql_dsn / database 已退役（ADR-0037 §2）：目标端凭据随每个 run 的请求过线，
# sink 不再持有自己的那一份。旧字段仍能解析，但一个字都不读，启动时会打一条 warn。
listen = "127.0.0.1:8080"
# 本进程即「目标端 agent」（ADR-0044）。下面两项都可以不写：
#   agent_name  —— 给人看的名字，留空取主机名；不作判据，只进 source 的界面。
#   agent_id_file —— 身份文件的位置，默认是本文件同目录下的 agent-id。
# 身份文件**不需要人来准备**：没有就在首次启动时现生成一个（0600）。它跨重启稳定，
# source 在注册那一刻把它钉住——删掉或换掉它，source 侧会判「身份不符」并停掉所有目标端链路，
# 处置是在「目标端 Agent」屏对这台重新保存一次。
# agent_name = "目标端 A"
# agent_id_file = "/etc/db-qbs/agent-id"
